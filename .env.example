# 复制为 .env 后按需修改（生产环境必须修改密码与密钥！）

# 运行环境：development / production（生产部署必须设 production）
FLASK_ENV=production

# MySQL（生产环境必须改密码！）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=请设置一个强密码
MYSQL_DATABASE=bilibili_bangumi

# Flask 密钥（生产必须设置随机值）
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 首个管理员：注册该用户名的账号且库中无管理员时自动成为管理员
ADMIN_USERNAME=admin

# CORS 允许来源（逗号分隔；同域部署可留空）
# CORS_ORIGINS=https://your-domain.com

# Redis（可选）
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_ENABLED=1
